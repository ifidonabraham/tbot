BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here
COINAPI_KEY=your_coinapi_key_here

# Use BROKER=binance for CCXT/Binance, or BROKER=exness_mt5 for Exness through MetaTrader 5.
BROKER=binance
SYMBOL=BTC/USDT
USE_TESTNET=true
PAPER_TRADING=true
LIVE_TRADING_CONFIRMATION=

MT5_ACCOUNT_MODE=demo
MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_SYMBOL=XAUUSD
WATCHLIST=XAUUSD,EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,EURJPY,GBPJPY,EURGBP,AUDJPY,CADJPY,CHFJPY,EURCHF,EURAUD,GBPAUD,AUDCAD,NZDJPY,XAGUSD,EURNZD,EURCAD,GBPCAD,GBPNZD,GBPCHF,AUDNZD,AUDCHF,NZDCAD,NZDCHF,CADCHF,USDNOK,USDSEK,USDDKK,USDZAR,USDHKD,USDSGD,EURSEK,EURNOK,EURDKK,EURPLN,EURTRY,GBPTRY,USDTRY,USDMXN,USDPLN,USDHUF,USDTHB,USDCNH,XPTUSD,XPDUSD
