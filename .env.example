# Layer 1 market funnel settings. Polygon.io is now Massive; old Polygon keys still work.
FUNNEL_USE_MT5=true
FUNNEL_USE_ALPHA_VANTAGE=true
FUNNEL_USE_MASSIVE=true
FUNNEL_REQUIRE_EXTERNAL_CONFIRMATION=true
FUNNEL_LOCAL_PREFILTER_ALL=true
FUNNEL_EXPAND_FOREX_UNIVERSE=true
FUNNEL_MAX_SYMBOLS=1000
FUNNEL_MAX_EXTERNAL_SYMBOLS=200
FUNNEL_MAX_RANGE_CANDIDATES=200
FUNNEL_MIN_SOURCE_AGREEMENT=2
FUNNEL_OUTPUT_PATH=data/layer1_candidates.csv
FUNNEL_MT5_TIMEOUT_MS=10000
FUNNEL_TIME_BUDGET_SECONDS=240
FUNNEL_HTTP_TIMEOUT_SECONDS=10
FUNNEL_ALPHA_SLEEP_SECONDS=1
FUNNEL_MIN_REMAINING_FOR_EXTERNAL_SECONDS=5
USE_FUNNEL_CANDIDATES=true
FUNNEL_TOP_N=5
FUNNEL_FALLBACK_TO_WATCHLIST=false
FUNNEL_MAX_SCALPER_SIDE_DISAGREEMENT=15
FUNNEL_CANDIDATE_MAX_AGE_SECONDS=300
SCALPER_TIER1_GATE_ENABLED=true
SCALPER_TIER1_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,EURJPY,GBPJPY,EURGBP,AUDJPY,CADJPY,CHFJPY,NZDJPY,EURCHF,EURAUD,EURNZD,EURCAD,GBPAUD,GBPCAD,GBPCHF,GBPNZD,AUDCAD,AUDCHF,AUDNZD,NZDCAD,NZDCHF,CADCHF,XAUUSD,XAGUSD
