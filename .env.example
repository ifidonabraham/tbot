BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here
COINAPI_KEY=your_coinapi_key_here

# Use BROKER=binance for CCXT/Binance, or BROKER=exness_mt5 for Exness through MetaTrader 5.
BROKER=binance
SYMBOL=BTC/USDT
USE_TESTNET=true
PAPER_TRADING=true
LIVE_TRADING_CONFIRMATION=

MT5_ACCOUNT_MODE=demo
MT5_REAL_LOGIN=0
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_DEMO_LOGIN=0
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_SYMBOL=XAUUSD
MT5_VOLUME=0.01
MT5_MAX_VOLUME=0.01
MT5_DEVIATION=20
MT5_MAGIC=260514
MT5_TIMEOUT_MS=30000
CONTRACT_SIZE=100

# Binance/CCXT spot example: 0.001 means 0.001 BTC.
# Exness/MT5 example: 0.01 means 0.01 lots, not 0.01 BTC.
TRADE_AMOUNT=0.001
MAX_TRADE_AMOUNT=0.001
BASE_ASSET=XAU
QUOTE_ASSET=USD
PAPER_STARTING_USDT=10000
PAPER_STARTING_BTC=0

TAKER_FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
MIN_PROFIT_PERCENT=0.30
STOP_LOSS_PERCENT=0.75
TAKE_PROFIT_PERCENT=1.00
MAX_DAILY_LOSS_USDT=25
MAX_TRADES_PER_DAY=6
MIN_USDT_RESERVE=10
MAX_CANDLE_RANGE_PERCENT=1.5
LOOP_SECONDS=60
