BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here
COINAPI_KEY=your_coinapi_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
MASSIVE_API_KEY=your_polygon_or_massive_key_here
MASSIVE_API_BASE=https://api.massive.com

# Layer 1 market funnel settings. Polygon.io is now Massive; old Polygon keys still work.
FUNNEL_USE_MT5=true
FUNNEL_USE_ALPHA_VANTAGE=true
FUNNEL_USE_MASSIVE=true
FUNNEL_REQUIRE_EXTERNAL_CONFIRMATION=true
FUNNEL_LOCAL_PREFILTER_ALL=true
FUNNEL_MAX_SYMBOLS=200
FUNNEL_MAX_EXTERNAL_SYMBOLS=25
FUNNEL_MIN_SOURCE_AGREEMENT=2
FUNNEL_OUTPUT_PATH=data/layer1_candidates.csv
FUNNEL_MT5_TIMEOUT_MS=10000

# Layer 2 support/resistance settings.
LAYER2_ENABLE_SUPPORT_RESISTANCE=true
LAYER2_LOOKBACK_CANDLES=200
LAYER2_MIN_LOOKBACK_CANDLES=50
LAYER2_SWING_LEFT_RIGHT=2
LAYER2_LEVEL_TOLERANCE_PERCENT=0.10
LAYER2_MAX_DISTANCE_PERCENT=0.50
LAYER2_MIN_TESTS=2
LAYER2_USE_TRADINGVIEW_WEBHOOK=false
LAYER2_TRADINGVIEW_LEVELS_PATH=data/tradingview_levels.csv
LAYER2_USE_DUKASCOPY=true
DUKASCOPY_MAX_HOURS=260
TRADINGVIEW_WEBHOOK_HOST=0.0.0.0
TRADINGVIEW_WEBHOOK_PORT=8787
TRADINGVIEW_WEBHOOK_SECRET=

# Layer 3 breakout detection settings.
LAYER3_ENABLE_BREAKOUT=true
LAYER3_TIMEFRAME=M5
LAYER3_LOOKBACK_CANDLES=80
LAYER3_AVG_CANDLE_PERIOD=20
LAYER3_MIN_VOLUME_RATIO=1.20
LAYER3_MIN_CANDLE_RANGE_RATIO=1.20
LAYER3_MAX_BREAKOUT_DISTANCE_PERCENT=0.30
LAYER3_RECENT_BREAKOUT_CANDLES=5
LAYER3_PULLBACK_DISTANCE_PERCENT=0.15
LAYER3_USE_BOOKMAP=false
BOOKMAP_ORDERFLOW_PATH=data/bookmap_orderflow.json
BOOKMAP_MAX_SIGNAL_AGE_SECONDS=5
BOOKMAP_MIN_IMBALANCE_RATIO=1.20
BOOKMAP_MIN_TRADE_DELTA=0
BOOKMAP_DEPTH_LEVELS=10
LAYER3_USE_MT5_TICK_CONFIRMATION=true
LAYER3_TICK_LOOKBACK_SECONDS=60
LAYER3_MAX_TICKS=2000
LAYER3_MIN_TICKS=20
LAYER3_MIN_TICK_IMBALANCE=1.10
LAYER3_MAX_SPREAD_PERCENT=0.05

# Layer 4 pullback confirmation settings.
LAYER4_ENABLE_PULLBACK=true
LAYER4_TIMEFRAME=M5
LAYER4_LOOKBACK_CANDLES=120
LAYER4_MIN_LOOKBACK_CANDLES=60
LAYER4_SWING_LOOKBACK_CANDLES=60
LAYER4_MAX_PULLBACK_DISTANCE_PERCENT=0.20
LAYER4_PULLBACK_VOLUME_WINDOW=5
LAYER4_KEEP_WAIT_CANDIDATES=true

# Layer 5 range filter settings for non-trending symbols.
LAYER5_ENABLE_RANGE_FILTER=true
LAYER5_TIMEFRAME=M15
LAYER5_LOOKBACK_CANDLES=120
LAYER5_MIN_LOOKBACK_CANDLES=80
LAYER5_MIN_RANGE_WIDTH_PIPS=30
LAYER5_ATR_PERIOD=14
LAYER5_MIN_RANGE_WIDTH_ATR=2.0
LAYER5_SUPPORT_QUANTILE=0.10
LAYER5_RESISTANCE_QUANTILE=0.90
LAYER5_TOUCH_TOLERANCE_FRACTION=0.12
LAYER5_MIN_TOUCHES_PER_SIDE=2
LAYER5_ENTRY_ZONE_FRACTION=0.20
LAYER5_MAX_SPREAD_PERCENT=0.05
LAYER5_MIN_RANGE_SPREAD_RATIO=8.0

# AI intelligence layer. Keep disabled until you add a real key.
AI_ENABLED=false
AI_PROVIDER=nvidia
AI_USE_FOR_LAYER6=true
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_TIMEOUT_SECONDS=20
NVIDIA_TEMPERATURE=0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_TEMPERATURE=0.1
GEMINI_MIN_CANDLE_SCORE=70
GEMINI_ALLOW_FLEXIBLE_FUNNEL=true

# Layer 6 price action scoring.
LAYER6_ENABLE_PRICE_ACTION=true
LAYER6_TIMEFRAME=M5
LAYER6_LOOKBACK_CANDLES=40
LAYER6_MAX_KEY_LEVEL_DISTANCE_PERCENT=0.25

# Layer 7/8 are scaffolded but disabled until their external data connectors are added.
LAYER7_ENABLE_FUNDAMENTALS=false
LAYER8_ENABLE_NEWS_SENTIMENT=false

# Composite AI scoring engine weights.
SCORER_MIN_COMPOSITE_SCORE=65
SCORER_WEIGHT_LAYER1=20
SCORER_WEIGHT_LAYER2=15
SCORER_WEIGHT_LAYER3=15
SCORER_WEIGHT_LAYER4=15
SCORER_WEIGHT_LAYER5=10
SCORER_WEIGHT_LAYER6=10
SCORER_WEIGHT_LAYER7=10
SCORER_WEIGHT_LAYER8=5
SCORER_RANGE_WEIGHT_LAYER1=15
SCORER_RANGE_WEIGHT_LAYER2=15
SCORER_RANGE_WEIGHT_LAYER3=0
SCORER_RANGE_WEIGHT_LAYER4=0
SCORER_RANGE_WEIGHT_LAYER5=25
SCORER_RANGE_WEIGHT_LAYER6=20
SCORER_RANGE_WEIGHT_LAYER7=15
SCORER_RANGE_WEIGHT_LAYER8=10

# Use BROKER=binance for CCXT/Binance, or BROKER=exness_mt5 for Exness through MetaTrader 5.
BROKER=binance
SYMBOL=BTC/USDT
USE_TESTNET=true
PAPER_TRADING=true
LIVE_TRADING_CONFIRMATION=

MT5_ACCOUNT_MODE=demo
MT5_REAL_LOGIN=
MT5_REAL_PASSWORD=
MT5_REAL_SERVER=
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
