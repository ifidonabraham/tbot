BOOKMAP_MAX_SIGNAL_AGE_SECONDS=5
BOOKMAP_MIN_IMBALANCE_RATIO=1.20
BOOKMAP_MIN_TRADE_DELTA=0
BOOKMAP_DEPTH_LEVELS=10
