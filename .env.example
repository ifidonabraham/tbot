# Layer 2 support/resistance settings.
LAYER2_ENABLE_SUPPORT_RESISTANCE=true
LAYER2_LOOKBACK_CANDLES=200
LAYER2_MIN_LOOKBACK_CANDLES=50
LAYER2_SWING_LEFT_RIGHT=2
LAYER2_LEVEL_TOLERANCE_PERCENT=0.10
LAYER2_MAX_DISTANCE_PERCENT=0.50
LAYER2_MIN_TESTS=2
LAYER2_USE_TRADINGVIEW_WEBHOOK=false
LAYER2_TRADINGVIEW_LEVELS_PATH=data/tradingview_levels.csv
